# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./inventory.db

# Authentication (Keycloak OIDC)
# In production, DEMO_MODE must remain false and valid Keycloak OIDC issuer configured.
DEMO_MODE=true
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/cloud-inventory
OIDC_CLIENT_ID=cloud-inventory-client
OIDC_AUDIENCE=cloud-inventory-client
OIDC_JWKS_URI=http://127.0.0.1:8080/realms/cloud-inventory/protocol/openid-connect/certs

# LLM Advisory Provider Configuration (Optional, non-secret defaults)
# Supported providers: openai-compatible, anthropic, gemini, ollama
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
